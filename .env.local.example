NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=your_supabase_jwks_url
DATABASE_URL=your_database_url
TOTP_ENCRYPTION_KEY=your_totp_encryption_key_at_least_32_chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_INVITE_TOKEN_SECRET=your_random_32_char_secret

# --- WebAuthn / Passkeys Configuration ---
# RP_ID = domain only (no port/scheme), e.g., localhost or yourdomain.com
WEBAUTHN_RP_ID=localhost
# In production, use your actual domain without https:// or port
# WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=ABF Admin
WEBAUTHN_ORIGIN=http://localhost:3000
# In production, use your actual domain with https://
# WEBAUTHN_ORIGIN=https://yourdomain.com

# --- Zoho Mail (replace hello@whisprwords.com with ABF's own domain when purchased) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=hello@whisprwords.com
SMTP_PASSWORD=your_zoho_app_password
SMTP_FROM_NAME=Adeyinka Bakare Foundation
SMTP_FROM=hello@whisprwords.com
SMTP_HELLO_FROM=hello@whisprwords.com
SMTP_NO_REPLY=no-reply@whisprwords.com

# --- Email branding (change logo/image when ABF domain is ready) ---
EMAIL_LOGO_URL=https://ibb.co/LhSBgzZK
NEXT_PUBLIC_EMAIL_LOGO_URL=https://ibb.co/LhSBgzZK
# Optional: override hero/background images for emails (Unsplash defaults are fellowship-aligned)
EMAIL_HERO_IMAGE=https://images.unsplash.com/photo-1523240795612-9da7e0c2ba7d?auto=format&fit=crop&w=1200&q=80
EMAIL_BG_IMAGE=https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1600&q=60
